{
  "name": "civictrack",
  "version": "1.0.0",
  "description": "Public Grievance Tracker — CivicTrack",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "cd client && npm run dev",
    "dev:server": "cd server && npm run dev",
    "build": "npm run build:client && npm run build:server",
    "build:client": "cd client && npm run build",
    "build:server": "cd server && npm run build",
    "db:init": "cd server && npm run db:init",
    "db:seed": "cd server && npm run db:seed",
    "db:reset": "cd server && npm run db:reset",
    "db:migrate-pg": "cd server && npx tsx src/database/migrate-to-supabase.ts",
    "test": "cd server && npm test",
    "test:client": "cd client && npm test",
    "lint": "cd client && npm run lint",
    "typecheck": "npm run build",
    "setup": "npm install && cd client && npm install && cd ../server && npm install && npm run db:init && npm run db:seed"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
