            "body": {
              "mode": "raw",
              "raw": "{\n  \"department_id\": 1,\n  \"officer_id\": 2,\n  \"reason\": \"Assigning to Ward 150 Senior Road Maintenance Engineer.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/complaints/{{complaintId}}/assign",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "complaints",
                "{{complaintId}}",
                "assign"
              ]
            },
            "description": "Assigns grievance to specific department and field officer. Requires manager or admin role."
          }
        },
